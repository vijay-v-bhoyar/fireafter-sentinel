# Sentinel only. Copy to .env.local and supply fresh-project values securely.
# Leave these blank until the independent targets are selected; no old defaults.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SENTINEL_TARGET_SUPABASE_URL=
# Comma-separated protected FireAfter database origins, identifiers only.
SENTINEL_PROTECTED_SUPABASE_URLS=
SENTINEL_ALLOW_LOCAL_DB=false
SENTINEL_TARGET_APP_URL=http://127.0.0.1:3020
SENTINEL_PROTECTED_APP_URLS=https://fireafter-app.vercel.app
SENTINEL_TARGET_REPO_ROOT=
SENTINEL_TARGET_REPOSITORY_URL=
# Provider transports exist locally; live account/pricing/tokenizer/worker qualification is pending.
SENTINEL_NEBIUS_API_KEY=
SENTINEL_NEBIUS_BASE_URL=
SENTINEL_NEMOTRON_EXTRACTION_MODEL=
SENTINEL_NEMOTRON_RECONCILIATION_MODEL=
SENTINEL_TAVILY_API_KEY=
SENTINEL_BUDGET_CEILING=
SENTINEL_TOKENIZER_EVIDENCE_HASH=
# Native evidence signing: separate Sentinel server key and owner-provisioned database authority.
# Leave unset until the new target is admitted. Key is 32 bytes / 64 lowercase hexadecimal characters.
SENTINEL_NATIVE_SIGNING_KEY_ID=
SENTINEL_NATIVE_SIGNING_ORGANIZATION_ID=
SENTINEL_NATIVE_SIGNING_KEY_HEX=
SENTINEL_MONITOR_ENABLED=false
